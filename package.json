    "test": "vitest run",
    "api:generate": "node scripts/gen-api.mjs",
    "api:check": "node scripts/gen-api.mjs --check"
  },
  "dependencies": {
    "@avalon-initiative/pyn-common-ui": "^0.1.16",
    "openapi-fetch": "0.17.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
