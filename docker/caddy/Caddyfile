{
	admin off
	skip_install_trust
	grace_period 10s
	default_sni {$PYN_DEFAULT_SNI:localhost}
	log {
		output stderr
		format json
	}
	servers {
		trusted_proxies static {$PYN_TRUSTED_PROXY_RANGES:}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

{$PYN_SITE:http://:8080} {
	import tls/{$PYN_TLS:off}.caddy
	import log/{$PYN_ACCESS_LOG:off}.caddy

	root * /srv

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# X-Forwarded-Proto and -Host are kept from a trusted proxy in front and set from the request otherwise.
	# The probes are answered by the server (through one copy when several are listed) and never cached.
	@api path /v1/* /healthz /readyz
	@probe path /healthz /readyz
	handle @api {
		header @probe >Cache-Control no-store
		reverse_proxy {$PYN_API_URL} {
			flush_interval -1
			request_buffers 0
			header_up X-Forwarded-For {client_ip}
			import lb/{$PYN_LB:single}.caddy
			transport http {
				dial_timeout 10s
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Vite names these files by content hash.
	handle /assets/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Client routes fall back to the app shell, which must always be revalidated.
	handle {
		encode zstd gzip
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

http://127.0.0.1:8082 {
	bind 127.0.0.1
	respond /health "ok"
}
